{
  "name": "@mmon-co/ncept-bb",
  "version": "0.2.2",
  "description": "One bb thread per Common Concept tutoring Session",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmon-co/ncept.git",
    "directory": "packages/bb"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --cwd ../pi build && bb plugin build",
    "source:install": "bun scripts/source-install.ts",
    "encounter:entries": "bun scripts/entry-encounter.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@mmon-co/ncept-core": "^0.4.0",
    "@mmon-co/ncept-default-theory": "^3.0.0",
    "@mmon-co/ncept-local": "^0.3.1",
    "@mmon-co/ncept-pi": "^0.3.1",
    "@xyflow/react": "12.10.1",
    "d3-force": "3.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@get-bb/plugin-sdk": "0.6.104",
    "@types/d3-force": "3.0.10",
    "@types/react": "19.2.18",
    "bun-types": "^1.3.14",
    "react": "19.2.8",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.104",
    "node": ">=22.19.0"
  },
  "bb": {
    "name": "Common Concept",
    "description": "Learn from a Profile you own, with a thread per tutoring Session.",
    "branding": {
      "icon": "BookOpen"
    },
    "server": "./src/server.ts",
    "app": "./src/app.tsx",
    "host": "./src/host.ts",
    "skills": [
      "skills"
    ]
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
