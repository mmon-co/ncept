{
  "name": "@mmon-co/ncept-pi",
  "version": "0.3.2",
  "description": "Learn in pi from a Profile directory you own",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmon-co/ncept.git",
    "directory": "packages/pi"
  },
  "bin": {
    "ncept-pi": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/init.d.ts",
      "default": "./dist/init.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  },
  "scripts": {
    "build": "bun run --cwd ../local build && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@mmon-co/ncept-core": "^0.4.0",
    "@mmon-co/ncept-default-theory": "^3.0.0",
    "@mmon-co/ncept-local": "^0.3.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "bun-types": "^1.3.14",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
