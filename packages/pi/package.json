{
  "name": "@mmon-co/pi",
  "version": "0.1.0",
  "description": "Learn in pi from a Profile directory you own",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmon-co/mmon.git",
    "directory": "packages/pi"
  },
  "bin": {
    "mmon-pi": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/init.d.ts",
      "default": "./dist/init.js"
    }
  },
  "scripts": {
    "build": "bun run --cwd ../local build && bun run --cwd ../default-theory build && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@mmon-co/core": "^0.1.0",
    "@mmon-co/default-theory": "^1.0.0",
    "@mmon-co/local": "^0.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "bun-types": "^1.3.14",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
