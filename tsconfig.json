{
  "compilerOptions": {
    "paths": {
      "@mmon-co/ncept-core": ["./packages/core/src/index.ts"],
      "@mmon-co/ncept-core/*": ["./packages/core/src/*"],
      "@mmon-co/ncept-default-theory": ["./packages/default-theory/src/index.ts"],
      "@mmon-co/ncept-default-theory/*": ["./packages/default-theory/src/*"],
      "@mmon-co/ncept-local": ["./packages/local/src/index.ts"],
      "@mmon-co/ncept-local/*": ["./packages/local/src/*"]
    },
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": ["packages/**/*.ts"]
}
